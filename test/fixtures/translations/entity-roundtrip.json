{
  "_meta": {
    "exportedAt": "2026-07-03T16:18:37.742Z",
    "label": "Translation roundtrip: entities → placeholders → translated → restored",
    "schema": "TranslationFixture",
    "description": "Tests the full entity protection pipeline (serializeForAI → restoreEntities)"
  },
  "testCases": [
    {
      "id": "basic-mixed-entities",
      "description": "Tweet with mention, hashtag, url, and media_alt entities",
      "originalEntities": [
        {
          "type": "text",
          "text": "Hello ",
          "index": 0
        },
        {
          "type": "mention",
          "text": "@alice",
          "id_str": "1",
          "name": "Alice",
          "screen_name": "alice",
          "href": "https://twitter.com/alice",
          "index": 1
        },
        {
          "type": "text",
          "text": " check ",
          "index": 2
        },
        {
          "type": "hashtag",
          "text": "#cool",
          "tag": "cool",
          "href": "https://twitter.com/hashtag/cool",
          "index": 3
        },
        {
          "type": "text",
          "text": " ",
          "index": 4
        },
        {
          "type": "url",
          "text": "https://t.co/abc",
          "shortUrl": "https://t.co/abc",
          "displayUrl": "example.com",
          "expandedUrl": "https://example.com",
          "href": "https://t.co/abc",
          "index": 5
        },
        {
          "type": "text",
          "text": " ",
          "index": 6
        },
        {
          "type": "media_alt",
          "text": "A CAT",
          "index": 20000
        }
      ],
      "expectedMaskedText": "Hello <<__MENTION_0__>> check <<__HASHTAG_1__>> <<__URL_2__>> A CAT",
      "aiTranslatedText": "你好 <<__MENTION_0__>> 看看 <<__HASHTAG_1__>> <<__URL_2__>> 一只猫",
      "expectedRestored": [
        {
          "type": "text",
          "text": "Hello ",
          "index": 0,
          "aiTranslation": "你好 "
        },
        {
          "type": "mention",
          "text": "@alice",
          "id_str": "1",
          "name": "Alice",
          "screen_name": "alice",
          "href": "https://twitter.com/alice",
          "index": 1
        },
        {
          "type": "text",
          "text": " check ",
          "index": 2,
          "aiTranslation": " 看看 "
        },
        {
          "type": "hashtag",
          "text": "#cool",
          "tag": "cool",
          "href": "https://twitter.com/hashtag/cool",
          "index": 3
        },
        {
          "type": "text",
          "text": " ",
          "index": 4,
          "aiTranslation": " "
        },
        {
          "type": "url",
          "text": "https://t.co/abc",
          "shortUrl": "https://t.co/abc",
          "displayUrl": "example.com",
          "expandedUrl": "https://example.com",
          "href": "https://t.co/abc",
          "index": 5
        },
        {
          "type": "text",
          "text": " ",
          "index": 6,
          "aiTranslation": " "
        },
        {
          "type": "media_alt",
          "text": "A CAT",
          "index": 20000
        }
      ]
    },
    {
      "id": "text-only",
      "description": "Plain text with no protectable entities",
      "originalEntities": [
        {
          "type": "text",
          "text": "Just some plain text with no special entities.",
          "index": 0
        }
      ],
      "expectedMaskedText": "Just some plain text with no special entities.",
      "aiTranslatedText": "只是一些普通的文本，没有特殊实体。",
      "expectedRestored": [
        {
          "type": "text",
          "text": "Just some plain text with no special entities.",
          "index": 0,
          "aiTranslation": "只是一些普通的文本，没有特殊实体。"
        }
      ]
    },
    {
      "id": "only-urls",
      "description": "Tweet containing only URLs (no mention/hashtag)",
      "originalEntities": [
        {
          "type": "url",
          "text": "https://t.co/xyz",
          "shortUrl": "https://t.co/xyz",
          "displayUrl": "site.com",
          "expandedUrl": "https://site.com",
          "href": "https://t.co/xyz",
          "index": 0
        }
      ],
      "expectedMaskedText": "<<__URL_0__>>",
      "aiTranslatedText": "<<__URL_0__>>",
      "expectedRestored": [
        {
          "type": "url",
          "text": "https://t.co/xyz",
          "shortUrl": "https://t.co/xyz",
          "displayUrl": "site.com",
          "expandedUrl": "https://site.com",
          "href": "https://t.co/xyz",
          "index": 0
        }
      ]
    }
  ]
}
